---
import Icon from "./Icon.astro";
---
<header class="topbar">
  <button class="icon-button nav-toggle" id="nav-toggle" type="button" aria-controls="sidebar" aria-expanded="false" aria-label="Open navigation"><Icon name="menu" /></button>
  <div class="breadcrumb"><span>Workspace</span><span class="crumb-sep" aria-hidden="true">/</span><strong id="project-label">demo</strong></div>
  <div class="topbar-right">
    <span id="service-status" class="status-chip"><span class="status-dot"></span>Connecting</span>
    <span class="host-label">Running locally</span>
  </div>
</header>

---
import Icon from "./Icon.astro";
---
<aside class="sidebar" id="sidebar" aria-label="Workspace navigation">
  <div class="sidebar-head">
    <a class="brand" href="./" aria-label="ML Pipeline Pro overview">
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="brand-name">Pipeline Pro</span>
    </a>
    <button class="icon-button sidebar-close" id="nav-close" type="button" aria-label="Close navigation"><Icon name="close" /></button>
  </div>
  <nav aria-label="Workspace views">
    <button class="nav-item active" data-view="runs" aria-current="page"><Icon name="overview" />Overview</button>
    <button class="nav-item" data-view="datasets"><Icon name="data" />Datasets<span id="nav-dataset-count" class="nav-count">0</span></button>
    <button class="nav-item" data-view="experiments"><Icon name="flask" />Experiments</button>
    <button class="nav-item" data-view="monitoring"><Icon name="pulse" />Monitoring</button>
  </nav>
  <div class="sidebar-bottom">
    <div class="project-card">
      <span class="project-label">Project</span>
      <strong id="sidebar-project">Project: demo</strong>
      <button id="connection-open" class="text-button" type="button"><Icon name="key" />Change connection</button>
    </div>
    <a class="sidebar-link" href="/docs" target="_blank" rel="noopener"><Icon name="external" />API reference</a>
  </div>
</aside>
<div class="scrim" id="nav-scrim" hidden></div>

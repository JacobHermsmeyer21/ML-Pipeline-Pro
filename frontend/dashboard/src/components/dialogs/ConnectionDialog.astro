---
import CloseButton from "./CloseButton.astro";
---
<dialog id="connection-dialog" aria-labelledby="connection-title"><form id="connection-form">
  <div class="dialog-heading"><h2 id="connection-title">Workspace connection</h2><CloseButton /></div>
  <p class="muted-note">Connect to a project on this machine. The key stays in this page's memory and is not saved.</p>
  <label>Project ID<input id="connection-project" value="demo" pattern="[a-zA-Z0-9_-]{1,128}" required></label>
  <label>API key, if configured<input id="connection-key" type="password" autocomplete="off"></label>
  <div class="dialog-actions"><button class="primary" type="submit">Connect</button></div>
</form></dialog>

---
import Icon from "./Icon.astro";
---
<section id="view-datasets" class="view-section" hidden>
  <article class="panel">
    <div class="panel-title"><div><h2>Add a dataset</h2><p>Upload a CSV, review how each column is encoded, then save it as a version.</p></div></div>
    <form id="upload-form">
      <label class="dropzone" for="dataset-file">
        <span class="upload-symbol"><Icon name="upload" /></span>
        <strong id="file-label">Choose a CSV file</strong>
        <span id="file-description">Original data with a target column. Splits can be created for you.</span>
        <span class="secondary file-choose">Browse files</span>
        <input id="dataset-file" type="file" accept=".csv,text/csv" required>
      </label>
      <div class="form-grid">
        <label>Dataset name<input id="dataset-name" placeholder="customer_outcomes" pattern="[a-zA-Z0-9_-]{1,80}" maxlength="80" required></label>
        <label>Version<input id="dataset-version" value="v1" pattern="[a-zA-Z0-9_-]{1,80}" maxlength="80" required></label>
        <label class="full-width">Prediction target<select id="dataset-target" required><option value="">Choose a CSV first</option></select></label>
      </div>
      <details class="settings-details">
        <summary>Preparation settings <span>70 / 15 / 15 split, seed 42</span></summary>
        <div class="form-grid form-grid-three">
          <label>Training %<input id="split-train" type="number" min="1" max="98" value="70" required></label>
          <label>Validation %<input id="split-validation" type="number" min="1" max="98" value="15" required></label>
          <label>Test %<input id="split-test" type="number" min="1" max="98" value="15" required></label>
          <label>Split seed<input id="split-seed" type="number" min="0" max="4294967295" value="42" required></label>
          <label>Existing split column<select id="dataset-split"><option value="">Create splits automatically</option></select></label>
          <label class="check-field"><input id="impute-missing" type="checkbox">Fill missing values with training medians and modes</label>
        </div>
        <p class="muted-note">Stratified random splits assume independent rows. Repeated subjects or time-ordered data need an existing split column.</p>
        <label class="check-field"><input id="prepared-upload" type="checkbox">Upload an already prepared numeric CSV</label>
        <label id="legacy-features" hidden>Feature columns<input id="dataset-features" placeholder="feature_1, feature_2"><small>Prepared mode keeps the original numeric features, integer labels and existing splits.</small></label>
      </details>
      <section id="upload-column-selection" class="encoding-review" hidden>
        <h3>Input columns</h3>
        <p id="upload-column-summary" class="muted-note"></p>
        <div id="upload-columns" class="column-choices"></div>
      </section>
      <div id="upload-limit" class="muted-note">UTF-8 CSV up to 10 MB with numeric and categorical features</div>
      <div class="form-footer">
        <a class="text-button" href="./example.csv" download="classification-example.csv"><Icon name="download" />Example CSV</a>
        <button id="upload-submit" class="secondary" type="submit">Preview encoding</button>
      </div>
      <section id="encoding-review" class="encoding-review" aria-label="Review dataset encoding" hidden>
        <div class="panel-title"><div><h3>Review the encoding</h3><p id="encoding-summary"></p></div></div>
        <p id="encoding-review-status" role="status" class="muted-note"></p>
        <div id="encoding-warnings" class="muted-note"></div>
        <div id="encoding-columns"></div>
        <h3>Target class IDs</h3>
        <p class="muted-note">Names stay readable. IDs must be distinct and cover 0 through the last class.</p>
        <div id="encoding-labels" class="encoding-labels"></div>
        <p class="muted-note">Encodings and fills are learned from training rows only. Unseen one-hot categories become all zeros; custom mappings use your fallback value.</p>
        <div class="form-footer">
          <button id="encoding-reset" class="quiet-button" type="button">Reset encoding choices</button>
          <button id="prepare-save" class="primary" type="button" disabled>Save reviewed dataset</button>
        </div>
      </section>
    </form>
    <div id="upload-result" class="notice" role="status" hidden></div>
  </article>
  <article class="panel">
    <div class="panel-title"><div><h2>Datasets</h2></div></div>
    <div id="column-recovery" class="notice warning" role="status" hidden></div>
    <div id="datasets-list" class="record-list"></div>
  </article>
</section>

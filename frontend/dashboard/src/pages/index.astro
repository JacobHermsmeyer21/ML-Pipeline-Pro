---
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/components.css";
import IconSprite from "../components/IconSprite.astro";
import Icon from "../components/Icon.astro";
import Sidebar from "../components/Sidebar.astro";
import Topbar from "../components/Topbar.astro";
import StatsGrid from "../components/StatsGrid.astro";
import LaunchPanel from "../components/LaunchPanel.astro";
import RunsPanel from "../components/RunsPanel.astro";
import DatasetsView from "../components/DatasetsView.astro";
import MonitoringView from "../components/MonitoringView.astro";
import AgentPanel from "../components/AgentPanel.astro";
import ConnectionDialog from "../components/dialogs/ConnectionDialog.astro";
import ModelDialog from "../components/dialogs/ModelDialog.astro";
import ModelsDialog from "../components/dialogs/ModelsDialog.astro";
import ReviewDialog from "../components/dialogs/ReviewDialog.astro";
import ColumnDialog from "../components/dialogs/ColumnDialog.astro";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Train, compare and monitor classification models on your own machine.">
  <title>Workspace · ML Pipeline Pro</title>
</head>
<body>
<IconSprite />
<a class="skip-link" href="#workspace">Skip to workspace</a>
<div class="shell">
  <Sidebar />
  <div class="page">
    <Topbar />
    <main id="workspace">
      <div id="preview-notice" class="notice preview-notice" hidden>Design preview. Controls are still being connected to the local backend.</div>
      <div class="page-intro">
        <h1>Overview</h1>
        <button class="primary" id="intro-upload" type="button"><Icon name="plus" />Add dataset</button>
      </div>
      <div id="global-message" class="notice" role="status" aria-live="polite" hidden></div>
      <div id="deletion-recovery" class="notice warning" role="status" aria-live="polite" hidden></div>
      <StatsGrid />
      <div class="workspace-grid">
        <div class="work-column">
          <section id="view-runs" class="view-section">
            <LaunchPanel />
            <RunsPanel />
            <article id="run-detail" class="panel" hidden></article>
            <article id="tuning-panel" class="panel" hidden>
              <div class="panel-title"><div><h2>Tuning jobs</h2><p>Bounded searches proposed by the agent.</p></div></div>
              <div id="tuning-list" class="record-list"></div>
            </article>
          </section>
          <DatasetsView />
          <MonitoringView />
        </div>
        <AgentPanel />
      </div>
      <footer class="page-footer">ML Pipeline Pro v0.1</footer>
    </main>
  </div>
</div>
<ConnectionDialog />
<ModelDialog />
<ModelsDialog />
<ReviewDialog />
<ColumnDialog />
<script>import "../lib/nav-drawer.js"; import "../lib/app.js";</script>
</body>
</html>

    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "monitoring-api",
        "namespace": "mlpp-demo"
      },
      "spec": {
        "selector": {
          "app": "monitoring-api"
        },
        "ports": [
          {
            "port": 8000,
            "targetPort": 8000
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "worker",
        "namespace": "mlpp-demo"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "worker"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "worker"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "worker",
                "image": "ml-pipeline-pro:midterm",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "memory": "128Mi",
                    "cpu": "100m"
                  },
                  "limits": {
                    "memory": "1Gi",
                    "cpu": "1"
                  }
                },
                "command": [
                  "celery",
                  "-A",
                  "ml_pipeline_pro.worker:app",
                  "worker",
                  "--loglevel=INFO",
                  "--concurrency=1",
                  "--queues=training,celery"
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "mlpp-config"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "mlpp-project-access"
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "artifacts",
                    "mountPath": "/app/artifacts"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "artifacts",
                "persistentVolumeClaim": {
                  "claimName": "artifacts"
                }
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "fsGroup": 10001
            }
          }
        },
        "strategy": {
          "type": "Recreate"
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "scheduler",
        "namespace": "mlpp-demo"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "scheduler"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "scheduler"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "scheduler",
                "image": "ml-pipeline-pro:midterm",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "memory": "128Mi",
                    "cpu": "50m"
                  },
                  "limits": {
                    "memory": "256Mi",
                    "cpu": "500m"
                  }
                },
                "command": [
                  "celery",
                  "-A",
                  "ml_pipeline_pro.worker:app",
                  "beat",
                  "--loglevel=INFO",
                  "--schedule=/tmp/mlpp-celerybeat"
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "mlpp-config"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "mlpp-project-access"
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "artifacts",
                    "mountPath": "/app/artifacts"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "artifacts",
                "persistentVolumeClaim": {
                  "claimName": "artifacts"
                }
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "fsGroup": 10001
            }
          }
        },
        "strategy": {
          "type": "Recreate"
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "gateway",
        "namespace": "mlpp-demo"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "gateway"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "gateway"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "gateway",
                "image": "nginx:1.28-alpine",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "memory": "128Mi",
                    "cpu": "50m"
                  },
                  "limits": {
                    "memory": "128Mi",
                    "cpu": "500m"
                  }
                },
                "ports": [
                  {
                    "containerPort": 8000
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/nginx/nginx.conf",
                    "subPath": "nginx.conf"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/api/v1/health/ready",
                    "port": 8000
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/api/v1/health/live",
                    "port": 8000
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/api/v1/health/live",
                    "port": 8000
                  },
                  "periodSeconds": 2,
                  "failureThreshold": 60
                }
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "gateway-config"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "gateway",
        "namespace": "mlpp-demo"
      },
      "spec": {
        "selector": {
          "app": "gateway"
        },
        "ports": [
          {
            "port": 8000,
            "targetPort": 8000
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "prometheus",
        "namespace": "mlpp-demo"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "prometheus"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "prometheus"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "prometheus",
                "image": "prom/prometheus:v3.5.0",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "memory": "128Mi",
                    "cpu": "50m"
                  },
                  "limits": {
                    "memory": "512Mi",
                    "cpu": "500m"
                  }
                },
                "command": [
                  "/bin/prometheus",
                  "--config.file=/etc/prometheus/prometheus.yaml",
                  "--storage.tsdb.retention.time=1d"
                ],
                "ports": [
                  {
                    "containerPort": 9090
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/prometheus"
                  }
                ],
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 9090
                  },
                  "periodSeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "prometheus-config"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "prometheus",
        "namespace": "mlpp-demo"
      },
      "spec": {
        "selector": {
          "app": "prometheus"
        },
        "ports": [
          {
            "port": 9090,
            "targetPort": 9090
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "grafana",
        "namespace": "mlpp-demo"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "grafana"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "grafana"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "grafana",
                "image": "grafana/grafana:12.1.1",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "memory": "128Mi",
                    "cpu": "50m"
                  },
                  "limits": {
                    "memory": "512Mi",
                    "cpu": "500m"
                  }
                },
                "ports": [
                  {
                    "containerPort": 3000
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/grafana/provisioning/datasources/prometheus.yaml",
                    "subPath": "datasource.yaml"
                  },
                  {
                    "name": "config",
                    "mountPath": "/etc/grafana/provisioning/dashboards/provider.yaml",
                    "subPath": "provider.yaml"
                  },
                  {
                    "name": "config",
                    "mountPath": "/etc/grafana/provisioning/dashboards/workload.json",
                    "subPath": "workload.json"
                  }
                ],
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 3000
                  },
                  "periodSeconds": 5
                },
                "env": [
                  {
                    "name": "GF_AUTH_ANONYMOUS_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "GF_AUTH_ANONYMOUS_ORG_ROLE",
                    "value": "Viewer"
                  },
                  {
                    "name": "GF_AUTH_DISABLE_LOGIN_FORM",
                    "value": "true"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "grafana-config"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "grafana",
        "namespace": "mlpp-demo"
      },
      "spec": {
        "selector": {
          "app": "grafana"
        },
        "ports": [
          {
            "port": 3000,
            "targetPort": 3000
          }
        ]
      }
    }
  ]
}

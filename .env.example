# Copy to .env for a host-based API. Docker Compose uses container hostnames.
MLPP_ENVIRONMENT=development
MLPP_LOG_LEVEL=INFO
MLPP_MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MLPP_MONGODB_DATABASE=ml_pipeline_pro
MLPP_REDIS_URL=redis://127.0.0.1:6379/0
MLPP_DEPENDENCY_TIMEOUT_SECONDS=2
MLPP_ARTIFACT_ROOT=./artifacts
MLPP_DATASET_ROOT=./examples/data
MLPP_DATASET_MAX_BYTES=10000000
MLPP_DATASET_MAX_ROWS=100000
# Optional locally; required for MLPP_ENVIRONMENT=production. Use your own keys.
# MLPP_PROJECT_API_KEYS={"demo":"replace-with-a-long-random-key"}
MLPP_WORKER_LEASE_SECONDS=30
MLPP_WORKER_MAX_ATTEMPTS=3

# Conversation routes and confirmed actions exist; live-model verification is pending.
# Chat is opt-in. No model tag is selected or downloaded automatically.
MLPP_CHAT_ENABLED=false
MLPP_CHAT_BACKEND=ollama
MLPP_CHAT_PROTOCOL=native
# Explicit verified Qwen tokenizer path; empty preserves generic adapter behavior.
# MLPP_CHAT_TOKENIZER_PATH=.tools/local-model-setup/tokenizer.json
# Select guided for schema-constrained single-step classification/demo responses.
# MLPP_CHAT_MODEL=your-installed-model:explicit-tag
MLPP_CHAT_MODEL_ORIGIN=http://127.0.0.1:11434
MLPP_CHAT_API_ORIGIN=http://127.0.0.1:8000
MLPP_CHAT_TIMEOUT_SECONDS=60
MLPP_CHAT_MODEL_TIMEOUT_SECONDS=20
# Explicit non-production timing experiment only. Both timeouts must be 'none' when enabled.
# Leaves normal profiles bounded; crashed diagnostic turns do not expire automatically.
MLPP_CHAT_UNBOUNDED_DIAGNOSTIC=false
# Allowed finite chat/model ceilings: 300 seconds; model <= complete turn.
# Opt-in laptop-five-minute deployment: turn=270, model=240; defaults above stay unchanged.
# Use compose.laptop.yaml and the matching walkthrough/evaluation --timing-profile.
MLPP_CHAT_ACTION_TIMEOUT_SECONDS=30
MLPP_CHAT_MAX_MODEL_CALLS=5
MLPP_CHAT_MAX_TOOL_CALLS=4
MLPP_CHAT_MAX_OUTPUT_TOKENS=1024
MLPP_CHAT_CONTEXT_TOKENS=8192
# Set OLLAMA_NO_CLOUD=1 in the separate Ollama server's environment during setup.
